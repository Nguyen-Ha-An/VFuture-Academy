# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
.npm-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env
!.env.example
.env.local

# e2e
playwright-report/
playwright-report-studio/
playwright-report-admin/
test-results/
test-results-admin/
/test-results-*/
recovery-evidence/
/playwright/.auth/**

# local git worktrees
.worktrees/

# local planning artifacts
/.superpowers/
/graphify-out/
/.claude/

# Generated preview-only hosting configuration
/.vercel.preview.json

# Supabase CLI local metadata
/supabase/.temp/

# Local notebook runtime build
/notebook-runtime/.venv/
/notebook-runtime/node_modules/
/notebook-runtime/dist/
/notebook-runtime/lib/
/notebook-runtime/labextension/

/.jupyterlite.doit.db

# Generated Studio worker (bundled by predev/prebuild)
/public/studio-workers/

# Isolated student browser acceptance artifacts
/tests/e2e/student-harness/artifacts/
/tests/e2e/student-harness/.cache/
/tests/e2e/student-harness/dist/
.gstack/

# Generated Azure runtime vendor files and Python syntax caches
/infra/azure/runtime/upstream/
/infra/azure/**/__pycache__/
