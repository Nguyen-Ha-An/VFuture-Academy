{
  "name": "academy",
  "services": {
    "db": {
      "image": "supabase/postgres:17.6.1.136@sha256:f371b5f3f2ac0a05703f33d6e6134515fb2498cab708fb948a0aeb7481467c00",
      "restart": "unless-stopped",
      "mem_limit": "1536m",
      "memswap_limit": "1536m",
      "pids_limit": 128,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      },
      "networks": [
        "backend"
      ],
      "shm_size": "256m",
      "environment": {
        "POSTGRES_HOST": "/var/run/postgresql",
        "POSTGRES_PORT": "5432",
        "PGPORT": "5432",
        "POSTGRES_DB": "postgres",
        "PGDATABASE": "postgres",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:?required}",
        "JWT_EXP": "3600",
        "JWT_SECRET": "${JWT_SECRET:?required}",
        "PGPASSWORD": "${POSTGRES_PASSWORD:?required}"
      },
      "volumes": [
        "/srv/academy/postgres:/var/lib/postgresql/data",
        "/srv/academy/postgres-config:/etc/postgresql-custom",
        "./upstream/roles.sql:/docker-entrypoint-initdb.d/init-scripts/99-roles.sql:ro",
        "./upstream/jwt.sql:/docker-entrypoint-initdb.d/init-scripts/99-jwt.sql:ro",
        "./upstream/_supabase.sql:/docker-entrypoint-initdb.d/migrations/97-_supabase.sql:ro",
        "./upstream/webhooks.sql:/docker-entrypoint-initdb.d/init-scripts/98-webhooks.sql:ro",
        "./limits.sql:/docker-entrypoint-initdb.d/init-scripts/zzz-academy-limits.sql:ro"
      ],
      "command": [
        "postgres",
        "-c",
        "config_file=/etc/postgresql/postgresql.conf",
        "-c",
        "max_connections=40",
        "-c",
        "shared_buffers=256MB",
        "-c",
        "work_mem=4MB",
        "-c",
        "maintenance_work_mem=64MB",
        "-c",
        "max_parallel_workers_per_gather=0",
        "-c",
        "jit=off",
        "-c",
        "statement_timeout=10000",
        "-c",
        "lock_timeout=2000",
        "-c",
        "idle_in_transaction_session_timeout=15000",
        "-c",
        "cron.max_running_jobs=2",
        "-c",
        "log_min_messages=fatal",
        "-c",
        "log_min_error_statement=panic",
        "-c",
        "log_statement=none"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "pg_isready",
          "-U",
          "postgres",
          "-h",
          "localhost"
        ],
        "interval": "10s",
        "timeout": "3s",
        "retries": 10
      }
    },
    "auth": {
      "image": "supabase/gotrue:v2.197.0@sha256:1736a63078f5922b198c4cbe50f80ab9a2d3b54fe8b7b6cfb2e9dc5dbbc12c6b",
      "restart": "unless-stopped",
      "mem_limit": "192m",
      "memswap_limit": "192m",
      "pids_limit": 128,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      },
      "networks": [
        "backend",
        "outbound"
      ],
      "depends_on": {
        "db": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "GOTRUE_API_HOST": "0.0.0.0",
        "GOTRUE_API_PORT": "9999",
        "API_EXTERNAL_URL": "${SUPABASE_PUBLIC_URL:?required}/auth/v1",
        "GOTRUE_SITE_URL": "${ACADEMY_SITE_URL:?required}",
        "GOTRUE_URI_ALLOW_LIST": "${AUTH_REDIRECT_URLS:?required}",
        "GOTRUE_DB_DRIVER": "postgres",
        "GOTRUE_DB_DATABASE_URL": "postgres://supabase_auth_admin:${POSTGRES_PASSWORD:?required}@db:5432/postgres?connect_timeout=3",
        "GOTRUE_DB_MAX_POOL_SIZE": "4",
        "GOTRUE_DB_MAX_IDLE_POOL_SIZE": "2",
        "GOTRUE_JWT_SECRET": "${JWT_SECRET:?required}",
        "GOTRUE_JWT_EXP": "3600",
        "GOTRUE_JWT_ADMIN_ROLES": "service_role",
        "GOTRUE_JWT_AUD": "authenticated",
        "GOTRUE_JWT_DEFAULT_GROUP_NAME": "authenticated",
        "GOTRUE_JWT_ISSUER": "${SUPABASE_PUBLIC_URL:?required}/auth/v1",
        "GOTRUE_DISABLE_SIGNUP": "false",
        "GOTRUE_EXTERNAL_EMAIL_ENABLED": "true",
        "GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED": "false",
        "GOTRUE_MAILER_AUTOCONFIRM": "false",
        "GOTRUE_EXTERNAL_PHONE_ENABLED": "false",
        "GOTRUE_SMS_AUTOCONFIRM": "false",
        "GOTRUE_RATE_LIMIT_EMAIL_SENT": "100",
        "GOTRUE_SMTP_MAX_FREQUENCY": "60s",
        "GOTRUE_RATE_LIMIT_HEADER": "X-Forwarded-For",
        "GOTRUE_SMTP_HOST": "${SMTP_HOST:?required}",
        "GOTRUE_SMTP_PORT": "587",
        "GOTRUE_SMTP_USER": "${SMTP_USER:?required}",
        "GOTRUE_SMTP_PASS": "${SMTP_PASS:?required}",
        "GOTRUE_SMTP_ADMIN_EMAIL": "${SMTP_ADMIN_EMAIL:?required}",
        "GOTRUE_SMTP_SENDER_NAME": "VFuture Academy",
        "GOTRUE_MAILER_URLPATHS_INVITE": "/auth/v1/verify",
        "GOTRUE_MAILER_URLPATHS_CONFIRMATION": "/auth/v1/verify",
        "GOTRUE_MAILER_URLPATHS_RECOVERY": "/auth/v1/verify",
        "GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE": "/auth/v1/verify",
        "GOTRUE_LOG_LEVEL": "warn",
        "GOTRUE_EXTERNAL_GOOGLE_ENABLED": "${GOTRUE_EXTERNAL_GOOGLE_ENABLED:-false}",
        "GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID": "${GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID:-}",
        "GOTRUE_EXTERNAL_GOOGLE_SECRET": "${GOTRUE_EXTERNAL_GOOGLE_SECRET:-}",
        "GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI": "${SUPABASE_PUBLIC_URL:?required}/auth/v1/callback",
        "GOTRUE_MAILER_NOTIFICATIONS_PASSWORD_CHANGED_ENABLED": "false",
        "GOTRUE_MAILER_NOTIFICATIONS_EMAIL_CHANGED_ENABLED": "false",
        "GOTRUE_MAILER_NOTIFICATIONS_PHONE_CHANGED_ENABLED": "false",
        "GOTRUE_MAILER_NOTIFICATIONS_IDENTITY_LINKED_ENABLED": "false",
        "GOTRUE_MAILER_NOTIFICATIONS_IDENTITY_UNLINKED_ENABLED": "false",
        "GOTRUE_MAILER_NOTIFICATIONS_MFA_FACTOR_ENROLLED_ENABLED": "false",
        "GOTRUE_MAILER_NOTIFICATIONS_MFA_FACTOR_UNENROLLED_ENABLED": "false",
        "GOTRUE_MAILER_SECURE_EMAIL_CHANGE_ENABLED": "true"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "--spider",
          "-q",
          "http://127.0.0.1:9999/health"
        ],
        "interval": "10s",
        "timeout": "3s",
        "retries": 5
      }
    },
    "rest": {
      "image": "postgrest/postgrest:v14.18@sha256:c7cd7e265a85b05248abf53f4473fcec7e327c282d0bd0cf60f1551996d09fcf",
      "restart": "unless-stopped",
      "mem_limit": "192m",
      "memswap_limit": "192m",
      "pids_limit": 128,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      },
      "networks": [
        "backend"
      ],
      "depends_on": {
        "db": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "PGRST_DB_URI": "postgres://authenticator:${POSTGRES_PASSWORD:?required}@db:5432/postgres?connect_timeout=3",
        "PGRST_DB_SCHEMAS": "public",
        "PGRST_DB_ANON_ROLE": "anon",
        "PGRST_JWT_SECRET": "${JWT_SECRET:?required}",
        "PGRST_DB_POOL": "8",
        "PGRST_DB_POOL_ACQUISITION_TIMEOUT": "3",
        "PGRST_DB_USE_LEGACY_GUCS": "false",
        "PGRST_LOG_LEVEL": "crit",
        "PGRST_ADMIN_SERVER_PORT": "3001"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "postgrest",
          "--ready"
        ],
        "interval": "10s",
        "timeout": "3s",
        "retries": 5
      }
    },
    "storage": {
      "image": "supabase/storage-api:v1.81.0@sha256:98ffec5d0678803783c30e404c27f4ec65e97efbe014088f2a86b4b8b54b9f54",
      "restart": "unless-stopped",
      "mem_limit": "384m",
      "memswap_limit": "384m",
      "pids_limit": 128,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      },
      "networks": [
        "backend"
      ],
      "depends_on": {
        "db": {
          "condition": "service_healthy"
        },
        "rest": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "ANON_KEY": "${ANON_KEY:?required}",
        "SERVICE_KEY": "${SERVICE_ROLE_KEY:?required}",
        "AUTH_JWT_SECRET": "${JWT_SECRET:?required}",
        "POSTGREST_URL": "http://rest:3000",
        "DATABASE_URL": "postgres://supabase_storage_admin:${POSTGRES_PASSWORD:?required}@db:5432/postgres?connect_timeout=3",
        "DATABASE_MAX_CONNECTIONS": "4",
        "DATABASE_CONNECTION_TIMEOUT": "3000",
        "DATABASE_STATEMENT_TIMEOUT": "10000",
        "PG_QUEUE_MAX_CONNECTIONS": "1",
        "FILE_SIZE_LIMIT": "52428800",
        "STORAGE_BACKEND": "file",
        "FILE_STORAGE_BACKEND_PATH": "/var/lib/storage",
        "TENANT_ID": "academy",
        "GLOBAL_S3_BUCKET": "academy",
        "REGION": "southeastasia",
        "STORAGE_PUBLIC_URL": "${SUPABASE_PUBLIC_URL:?required}",
        "REQUEST_ALLOW_X_FORWARDED_PATH": "true",
        "ENABLE_IMAGE_TRANSFORMATION": "false",
        "LOG_LEVEL": "error",
        "PG_QUEUE_ENABLE": "false",
        "PG_QUEUE_WORKERS_ENABLE": "false"
      },
      "volumes": [
        "/srv/academy/objects:/var/lib/storage"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "--spider",
          "-q",
          "http://127.0.0.1:5000/status"
        ],
        "interval": "10s",
        "timeout": "3s",
        "retries": 5
      }
    },
    "gateway": {
      "image": "library/node:24.15.0-alpine3.23@sha256:d1b3b4da11eefd5941e7f0b9cf17783fc99d9c6fc34884a665f40a06dbdfc94f",
      "restart": "unless-stopped",
      "mem_limit": "160m",
      "memswap_limit": "160m",
      "pids_limit": 128,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      },
      "networks": {
        "backend": {},
        "edge": {
          "ipv4_address": "172.31.77.3"
        }
      },
      "user": "10001:10001",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "tmpfs": [
        "/tmp:size=8m,mode=1777"
      ],
      "working_dir": "/app",
      "command": [
        "node",
        "server.mjs"
      ],
      "environment": {
        "NODE_OPTIONS": "--max-old-space-size=96",
        "GATEWAY_AUTH_URL": "http://auth:9999",
        "GATEWAY_REST_URL": "http://rest:3000",
        "GATEWAY_STORAGE_URL": "http://storage:5000",
        "SUPABASE_GATEWAY_KEY": "${SUPABASE_GATEWAY_KEY:?required}",
        "GATEWAY_TRANSFER_GRANT_KEY": "${GATEWAY_TRANSFER_GRANT_KEY:?required}",
        "GATEWAY_STATE_DIR": "/state",
        "GATEWAY_MAINTENANCE_FILE": "/control/maintenance.json",
        "GATEWAY_TRUSTED_PROXY_IP": "172.31.77.2",
        "GATEWAY_ALLOWED_ORIGINS": "${ACADEMY_SITE_URL:?required}"
      },
      "volumes": [
        "../gateway:/app:ro",
        "/srv/academy/gateway-state:/state",
        "/srv/academy/control:/control:ro"
      ],
      "depends_on": {
        "auth": {
          "condition": "service_healthy"
        },
        "rest": {
          "condition": "service_healthy"
        },
        "storage": {
          "condition": "service_healthy"
        }
      },
      "stop_grace_period": "130s"
    },
    "tls": {
      "image": "library/nginx:1.29.6-alpine@sha256:f46cb72c7df02710e693e863a983ac42f6a9579058a59a35f1ae36c9958e4ce0",
      "restart": "unless-stopped",
      "mem_limit": "32m",
      "memswap_limit": "32m",
      "pids_limit": 128,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      },
      "networks": {
        "edge": {
          "ipv4_address": "172.31.77.2"
        }
      },
      "user": "101:101",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "ports": [
        "443:8443"
      ],
      "tmpfs": [
        "/tmp:size=8m,mode=1777"
      ],
      "entrypoint": [
        "nginx"
      ],
      "command": [
        "-g",
        "daemon off;"
      ],
      "volumes": [
        "./nginx.conf:/etc/nginx/nginx.conf:ro",
        "/etc/vfuture-academy/tls:/etc/academy-tls:ro"
      ],
      "depends_on": [
        "gateway"
      ]
    },
    "meta": {
      "image": "supabase/postgres-meta:v0.100.0@sha256:145325b7e39f8ef4931d6e8cfd3f6f4d655de09d72a2ccc96d9513542c2202bd",
      "restart": "unless-stopped",
      "mem_limit": "192m",
      "memswap_limit": "192m",
      "pids_limit": 128,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      },
      "networks": [
        "backend"
      ],
      "profiles": [
        "operator"
      ],
      "environment": {
        "PG_META_PORT": "8080",
        "PG_META_DB_HOST": "db",
        "PG_META_DB_PORT": "5432",
        "PG_META_DB_NAME": "postgres",
        "PG_META_DB_USER": "postgres",
        "PG_META_DB_PASSWORD": "${POSTGRES_PASSWORD:?required}",
        "CRYPTO_KEY": "${PG_META_CRYPTO_KEY:?required}"
      },
      "depends_on": {
        "db": {
          "condition": "service_healthy"
        }
      }
    },
    "studio": {
      "image": "supabase/studio:2026.10.12-sha-3699278@sha256:948770ec467f00e6ae34c35018ef7cb23d7b30eb806b42c2cc0d7bcfdcf8a7a8",
      "restart": "unless-stopped",
      "mem_limit": "384m",
      "memswap_limit": "384m",
      "pids_limit": 128,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      },
      "networks": [
        "operator",
        "backend"
      ],
      "profiles": [
        "operator"
      ],
      "ports": [
        "127.0.0.1:3000:3000"
      ],
      "environment": {
        "HOSTNAME": "0.0.0.0",
        "STUDIO_PG_META_URL": "http://meta:8080",
        "POSTGRES_HOST": "db",
        "POSTGRES_PORT": "5432",
        "POSTGRES_DB": "postgres",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:?required}",
        "PG_META_CRYPTO_KEY": "${PG_META_CRYPTO_KEY:?required}",
        "SUPABASE_URL": "http://operator-proxy:8081",
        "SUPABASE_PUBLIC_URL": "${SUPABASE_PUBLIC_URL:?required}",
        "SUPABASE_ANON_KEY": "${ANON_KEY:?required}",
        "SUPABASE_SERVICE_KEY": "${SERVICE_ROLE_KEY:?required}",
        "AUTH_JWT_SECRET": "${JWT_SECRET:?required}",
        "ENABLED_FEATURES_LOGS_ALL": "false",
        "DEFAULT_ORGANIZATION_NAME": "VFuture",
        "DEFAULT_PROJECT_NAME": "Academy"
      },
      "depends_on": [
        "meta",
        "operator-proxy"
      ]
    },
    "operator-proxy": {
      "image": "library/nginx:1.29.6-alpine@sha256:f46cb72c7df02710e693e863a983ac42f6a9579058a59a35f1ae36c9958e4ce0",
      "profiles": [
        "operator"
      ],
      "restart": "unless-stopped",
      "mem_limit": "32m",
      "memswap_limit": "32m",
      "pids_limit": 32,
      "user": "101:101",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp:size=8m,mode=1777"
      ],
      "entrypoint": [
        "nginx"
      ],
      "command": [
        "-c",
        "/etc/academy-operator.conf",
        "-g",
        "daemon off;"
      ],
      "volumes": [
        "/etc/vfuture-academy/operator-proxy.conf:/etc/academy-operator.conf:ro"
      ],
      "networks": {
        "operator": {
          "ipv4_address": "172.31.78.2"
        },
        "backend": {}
      },
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "1m",
          "max-file": "2"
        }
      }
    }
  },
  "networks": {
    "backend": {
      "internal": true
    },
    "outbound": {},
    "edge": {
      "ipam": {
        "config": [
          {
            "subnet": "172.31.77.0/29"
          }
        ]
      }
    },
    "operator": {
      "internal": true,
      "ipam": {
        "config": [
          {
            "subnet": "172.31.78.0/29"
          }
        ]
      }
    }
  }
}
