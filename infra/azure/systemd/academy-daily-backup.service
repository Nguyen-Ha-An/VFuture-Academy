[Unit]
Description=Academy daily guarded encrypted backup
After=docker.service network-online.target
Requires=docker.service
RequiresMountsFor=/srv/academy /srv/academy/objects
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/vfuture-academy/infra/azure/scripts/backup-coordinator.py daily
MemoryMax=256M
CPUQuota=50%
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=10800
NoNewPrivileges=true
