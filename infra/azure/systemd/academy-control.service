[Unit]
Description=Read Academy maintenance control using the VM identity
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/academy
[Service]
Slice=academy-monitor.slice
Type=oneshot
ExecStart=/usr/bin/python3 /opt/vfuture-academy/infra/azure/scripts/azure-host.py sync-control
MemoryMax=64M
TimeoutStartSec=25
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/academy/control
