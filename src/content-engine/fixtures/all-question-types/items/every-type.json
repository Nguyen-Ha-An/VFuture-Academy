{
  "$schema": "https://academy.vfuturelabs.org/schemas/v1/lesson.json", "schemaVersion": 1, "kind": "lesson", "id": "every-type",
  "title": "Every block type", "summary": "One of every renderable block, then one of every question type.",
  "objectives": ["Render every block type.", "Render every question type."], "estimatedMinutes": 45, "completion": { "mode": "activities" },
  "blocks": [
    { "type": "heading", "level": 2, "content": [{ "text": "Every renderable block" }] },
    { "type": "paragraph", "content": [{ "text": "Plain, " }, { "text": "bold", "annotations": { "bold": true } }, { "text": ", " }, { "text": "italic", "annotations": { "italic": true } }, { "text": ", " }, { "text": "underline", "annotations": { "underline": true } }, { "text": ", " }, { "text": "strike", "annotations": { "strike": true } }, { "text": ", " }, { "text": "code", "annotations": { "code": true } }, { "text": ", " }, { "text": "sub", "annotations": { "sub": true } }, { "text": ", " }, { "text": "sup", "annotations": { "sup": true } }, { "text": ", " }, { "text": "coloured", "annotations": { "color": "#2563eb" } }, { "text": ", " }, { "text": "a link", "annotations": { "link": { "href": "https://vfuturelabs.org", "target": "_blank" } } }, { "text": "." }], "align": "left" },
    { "type": "list", "ordered": false, "items": [{ "content": [{ "text": "one" }] }, { "content": [{ "text": "two" }], "items": [{ "content": [{ "text": "nested" }] }] }] },
    { "type": "quote", "content": [{ "text": "Data is the new oil." }], "author": "Clive Humby" },
    { "type": "image", "src": { "url": "https://images.unsplash.com/photo-1" }, "alt": "An abstract network of nodes", "caption": "External image by URL", "width": "md" },
    { "id": "video-file", "type": "video", "src": { "url": "https://xyz.supabase.co/storage/v1/object/public/media/clip.mp4" }, "caption": "Uploaded clip" },
    { "id": "video-provider", "type": "video", "provider": "vimeo", "url": "https://vimeo.com/76979871", "caption": "Provider clip" },
    { "id": "audio-1", "type": "audio", "src": { "assetId": "asset_intro_audio" }, "label": "Listen to the intro" },
    { "type": "table", "caption": "Blocks by category", "headers": [{ "content": [{ "text": "Category" }] }, { "content": [{ "text": "Example" }] }], "rows": [[{ "content": [{ "text": "content" }] }, { "content": [{ "text": "paragraph" }] }], [{ "content": [{ "text": "activity" }], "align": "left" }, { "content": [{ "text": "quiz" }] }]] },
    { "type": "code", "language": "typescript", "code": "export const sum = (a: number, b: number) => a + b;", "filename": "sum.ts", "showLineNumbers": true, "highlightLines": [1] },
    { "type": "divider" },
    { "id": "embed-1", "type": "embed", "url": "https://www.figma.com/embed?embed_host=share&url=x", "title": "Design file", "aspectRatio": "16:9" },
    { "id": "pdf-1", "type": "pdf", "src": { "assetId": "asset_handout_pdf" }, "title": "Course handout", "height": 600 },
    { "id": "callout-1", "type": "callout", "variant": "tip", "title": "Try it yourself", "blocks": [{ "id": "reveal-1", "type": "reveal", "label": "Show the answer", "blocks": [{ "type": "paragraph", "content": [{ "text": "A container may hold another container." }] }] }] },
    { "id": "cards-1", "type": "flashcards", "shuffle": true, "cards": [{ "id": "c1", "front": { "blocks": [{ "type": "paragraph", "content": [{ "text": "LLM" }] }] }, "back": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Large language model" }] }] } }, { "id": "c2", "front": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Token" }] }] }, "back": { "blocks": [{ "type": "paragraph", "content": [{ "text": "A chunk of text a model reads" }] }] } }] },
    { "id": "acc-1", "type": "accordion", "allowMultipleOpen": true, "items": [{ "id": "a1", "title": "Why blocks?", "blocks": [{ "type": "paragraph", "content": [{ "text": "Blocks compose." }] }] }, { "id": "a2", "title": "Why containers?", "blocks": [{ "type": "paragraph", "content": [{ "text": "Containers group." }] }] }] },
    { "id": "tabs-1", "type": "tabs", "items": [{ "id": "t1", "title": "Python", "blocks": [{ "type": "code", "language": "python", "code": "print(1)" }] }, { "id": "t2", "title": "JavaScript", "blocks": [{ "type": "code", "language": "javascript", "code": "console.log(1)" }] }] },
    { "id": "steps-1", "type": "stepper", "linear": true, "steps": [{ "id": "s1", "title": "Plan", "blocks": [{ "type": "paragraph", "content": [{ "text": "Sketch it." }] }] }, { "id": "s2", "title": "Build", "blocks": [{ "type": "paragraph", "content": [{ "text": "Ship it." }] }] }] },
    { "id": "reflect-1", "type": "reflection", "prompt": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Which block would you use for a demo recording?" }] }] }, "required": false, "minChars": 20, "maxChars": 800 },
    { "id": "res-1", "type": "resource_link", "resourceId": "responsible-ai-guide", "label": "Responsible AI guide", "required": false },
    { "id": "opp-1", "type": "opportunity_link", "opportunityId": "research-cohort-02", "relationship": "related" },
    { "id": "next-1", "type": "next_step", "title": "Visit VFuture Labs", "description": "Open the public site.", "target": { "kind": "url", "url": "https://vfuturelabs.org" } },
    { "id": "mini-task", "type": "assignment", "title": "Mini task", "instructions": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Paste a function that reverses a string." }] }] }, "submission": { "accepts": ["code"], "codeLanguage": "python" }, "rubric": { "criteria": [{ "id": "works", "name": "It runs", "maxPoints": 3 }] }, "skills": ["qa"], "resubmission": "once", "required": false },
    { "id": "all-q", "type": "quiz", "title": "One of every question type", "intro": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Thirteen questions, one per type." }] }] }, "settings": { "mode": "graded", "attemptsAllowed": 2, "feedback": "after_submit", "passPercent": 60, "showExplanations": true },
      "questions": [
        { "id": "q-single", "type": "single_choice", "points": 1, "display": { "interactionType": "button" }, "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Which block plays an uploaded MP4?" }] }] },
          "options": [{ "id": "a", "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "video" }] }] }, "feedback": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Correct — video takes a src or a provider url." }] }] } }, { "id": "b", "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "embed" }] }] } }, { "id": "c", "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "pdf" }] }] } }],
          "correctAnswer": "a", "explanation": { "blocks": [{ "type": "paragraph", "content": [{ "text": "The video block accepts an uploaded asset or a provider url." }] }] } },
        { "id": "q-multi", "type": "multiple_choice", "points": 2, "display": { "interactionType": "image" }, "settings": { "partialScoring": true }, "minSelections": 1, "maxSelections": 2, "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Select the images that show a diagram." }] }] },
          "options": [{ "id": "a", "content": { "blocks": [{ "type": "image", "src": { "assetId": "asset_ai_map" }, "alt": "Branches of AI" }, { "type": "paragraph", "content": [{ "text": "Branch map" }] }] } }, { "id": "b", "content": { "blocks": [{ "type": "image", "src": { "assetId": "asset_cover_ai" }, "alt": "Course cover art" }, { "type": "paragraph", "content": [{ "text": "Cover art" }] }] } }, { "id": "c", "content": { "blocks": [{ "type": "image", "src": { "url": "https://images.unsplash.com/photo-1" }, "alt": "A node graph" }, { "type": "paragraph", "content": [{ "text": "Node graph" }] }] } }],
          "correctAnswer": ["a", "c"], "explanation": { "blocks": [{ "type": "paragraph", "content": [{ "text": "The branch map and the node graph are diagrams; the cover is decoration." }] }] } },
        { "id": "q-tf", "type": "true_false", "display": { "interactionType": "yes_no" }, "labels": { "true": "Yes", "false": "No" }, "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Can a callout contain a reveal?" }] }] }, "correctAnswer": true, "explanation": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Containers nest up to three levels." }] }] } },
        { "id": "q-blank", "type": "fill_blank", "display": { "interactionType": "word_bank" }, "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "You send a " }, { "blank": "b1", "size": "md" }, { "text": " to a " }, { "blank": "b2" }, { "text": "." }] }] },
          "blanks": [{ "id": "b1" }, { "id": "b2" }], "wordBank": [{ "id": "w-prompt", "text": "prompt" }, { "id": "w-model", "text": "model" }, { "id": "w-token", "text": "token" }],
          "correctAnswer": { "b1": ["w-prompt"], "b2": ["w-model"] }, "explanation": { "blocks": [{ "type": "paragraph", "content": [{ "text": "A prompt goes to a model; a token is a chunk of text." }] }] } },
        { "id": "q-short", "type": "short_answer", "matchMode": "regex", "maxLength": 40, "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "What is the smallest chunk of text a model reads?" }] }] }, "correctAnswer": ["^tokens?$"], "explanation": { "blocks": [{ "type": "paragraph", "content": [{ "text": "A token." }] }] } },
        { "id": "q-numeric", "type": "numeric", "tolerancePercent": 2, "unit": "%", "precision": 1, "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "A model answers 42 of 50 items correctly. What is its accuracy in percent?" }] }] }, "correctAnswer": 84, "explanation": { "blocks": [{ "type": "paragraph", "content": [{ "text": "42 / 50 = 84%." }] }] } },
        { "id": "q-essay", "type": "essay", "points": 0, "selfAssessment": true, "prompts": ["What did you build?", "What would you change next time?"], "minWords": 50, "maxWords": 300, "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Write a short retrospective of your project." }] }] }, "sampleAnswer": { "blocks": [{ "type": "paragraph", "content": [{ "text": "A strong answer names the build and one concrete change." }] }] }, "rubric": { "criteria": [{ "id": "ideas", "name": "Ideas", "maxPoints": 4 }, { "id": "clarity", "name": "Clarity", "maxPoints": 2 }] } },
        { "id": "q-match", "type": "matching", "display": { "interactionType": "lines" }, "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Match each block to what it shows." }] }] },
          "left": [{ "id": "l-pdf", "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "pdf" }] }] } }, { "id": "l-audio", "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "audio" }] }] } }],
          "right": [{ "id": "r-doc", "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "A document" }] }] } }, { "id": "r-sound", "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "A sound file" }] }] } }, { "id": "r-slides", "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "A slide deck" }] }] } }],
          "correctAnswer": [{ "left": "l-pdf", "right": "r-doc" }, { "left": "l-audio", "right": "r-sound" }], "explanation": { "blocks": [{ "type": "paragraph", "content": [{ "text": "The slide deck is a distractor — that is an embed." }] }] } },
        { "id": "q-order", "type": "ordering", "display": { "interactionType": "timeline" }, "settings": { "partialScoring": true }, "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Put the authoring steps in order." }] }] },
          "items": [{ "id": "publish", "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Publish" }] }] } }, { "id": "draft", "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Draft" }] }] } }, { "id": "review", "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Review" }] }] } }],
          "slots": [{ "id": "slot-1", "label": "First" }, { "id": "slot-2", "label": "Second" }, { "id": "slot-3", "label": "Third" }],
          "correctAnswer": ["draft", "review", "publish"], "explanation": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Draft, then review, then publish." }] }] } },
        { "id": "q-classify", "type": "classification", "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Sort each block into its category." }] }] },
          "categories": [{ "id": "content", "label": "Content" }, { "id": "activity", "label": "Activity" }],
          "items": [{ "id": "i-table", "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "table" }] }] } }, { "id": "i-quiz", "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "quiz" }] }] } }, { "id": "i-reflection", "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "reflection" }] }] } }],
          "correctAnswer": { "i-table": "content", "i-quiz": "activity", "i-reflection": "activity" }, "explanation": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Only the table is a content block." }] }] } },
        { "id": "q-upload", "type": "upload_answer", "points": 0, "selfAssessment": true, "accepts": ["file", "link"], "allowedMimeTypes": ["application/pdf", "image/png"], "maxFiles": 2, "maxFileSizeMB": 20, "linkHosts": ["canva.com", "www.canva.com"], "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Upload your poster, or paste a Canva link." }] }] }, "rubric": { "criteria": [{ "id": "design", "name": "Design", "maxPoints": 5 }] } },
        { "id": "q-code", "type": "code_answer", "points": 0, "selfAssessment": true, "language": "typescript", "starterCode": "export function reverse(s: string): string {\n  return s;\n}", "minLines": 2, "sampleSolution": "export function reverse(s: string): string {\n  return [...s].reverse().join('');\n}", "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Finish reverse() so it returns the reversed string." }] }] }, "rubric": { "criteria": [{ "id": "works", "name": "Works", "maxPoints": 3 }, { "id": "style", "name": "Style", "maxPoints": 2 }] } },
        { "id": "q-group", "type": "question_group", "display": { "layout": "tabs" }, "sharedContent": { "blocks": [{ "type": "paragraph", "content": [{ "text": "A team ships a lesson that renders a quiz, a reflection and a stepper." }] }] },
          "questions": [
            { "id": "g-single", "type": "single_choice", "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "How many activity blocks did the team use?" }] }] }, "options": [{ "id": "two", "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Two" }] }] } }, { "id": "three", "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Three" }] }] } }], "correctAnswer": "three", "explanation": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Quiz, reflection and stepper are all activity blocks." }] }] } },
            { "id": "g-short", "type": "short_answer", "content": { "blocks": [{ "type": "paragraph", "content": [{ "text": "Name the block that holds ordered steps." }] }] }, "correctAnswer": ["stepper"], "matchMode": "exact", "explanation": { "blocks": [{ "type": "paragraph", "content": [{ "text": "The stepper block." }] }] } }
          ] }
      ] }
  ]
}
