{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "points": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "content": {
      "$ref": "#/$defs/__schema1"
    },
    "explanation": {
      "$ref": "#/$defs/__schema1"
    },
    "hint": {
      "$ref": "#/$defs/__schema1"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "transcript": {
          "$ref": "#/$defs/__schema12"
        }
      },
      "additionalProperties": false
    },
    "type": {
      "type": "string",
      "const": "short_answer"
    },
    "settings": {
      "type": "object",
      "properties": {
        "caseSensitive": {
          "type": "boolean"
        },
        "ignoreAccents": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "matchMode": {
      "type": "string",
      "enum": [
        "exact",
        "contains"
      ]
    },
    "maxLength": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "correctAnswer": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema15"
      }
    }
  },
  "required": [
    "id",
    "points",
    "content",
    "explanation",
    "type",
    "matchMode",
    "correctAnswer"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "blocks": {
          "minItems": 1,
          "maxItems": 200,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        }
      },
      "required": [
        "blocks"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema3"
            },
            "type": {
              "type": "string",
              "const": "paragraph"
            },
            "content": {
              "$ref": "#/$defs/__schema4"
            },
            "align": {
              "$ref": "#/$defs/__schema6"
            }
          },
          "required": [
            "type",
            "content"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema3"
            },
            "type": {
              "type": "string",
              "const": "list"
            },
            "ordered": {
              "type": "boolean"
            },
            "items": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema7"
              }
            }
          },
          "required": [
            "type",
            "ordered",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema3"
            },
            "type": {
              "type": "string",
              "const": "table"
            },
            "headers": {
              "minItems": 1,
              "maxItems": 12,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema10"
              }
            },
            "rows": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema11"
              }
            },
            "caption": {
              "$ref": "#/$defs/__schema12"
            }
          },
          "required": [
            "type",
            "rows"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema3"
            },
            "type": {
              "type": "string",
              "const": "code"
            },
            "language": {
              "type": "string",
              "enum": [
                "python",
                "javascript",
                "typescript",
                "tsx",
                "jsx",
                "html",
                "css",
                "json",
                "sql",
                "bash",
                "markdown",
                "yaml",
                "plaintext",
                "java",
                "c",
                "cpp",
                "csharp",
                "go",
                "rust",
                "swift",
                "kotlin",
                "r"
              ]
            },
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "filename": {
              "type": "string",
              "maxLength": 120
            },
            "highlightLines": {
              "maxItems": 200,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema13"
              }
            },
            "showLineNumbers": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "language",
            "code"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema3"
            },
            "type": {
              "type": "string",
              "const": "quote"
            },
            "content": {
              "$ref": "#/$defs/__schema4"
            },
            "author": {
              "$ref": "#/$defs/__schema12"
            }
          },
          "required": [
            "type",
            "content"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema3"
            },
            "type": {
              "type": "string",
              "const": "image"
            },
            "src": {
              "$ref": "#/$defs/__schema14"
            },
            "alt": {
              "$ref": "#/$defs/__schema12"
            },
            "caption": {
              "$ref": "#/$defs/__schema12"
            },
            "width": {
              "type": "string",
              "enum": [
                "sm",
                "md",
                "full"
              ]
            }
          },
          "required": [
            "type",
            "src",
            "alt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema3"
            },
            "type": {
              "type": "string",
              "const": "audio"
            },
            "src": {
              "$ref": "#/$defs/__schema14"
            },
            "label": {
              "$ref": "#/$defs/__schema12"
            }
          },
          "required": [
            "type",
            "src"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema3"
            },
            "type": {
              "type": "string",
              "const": "video"
            },
            "provider": {
              "type": "string",
              "enum": [
                "youtube",
                "vimeo"
              ]
            },
            "url": {
              "type": "string",
              "pattern": "^https:\\/\\/(?:youtube\\.com|www\\.youtube\\.com|youtu\\.be|www\\.youtube-nocookie\\.com|vimeo\\.com|player\\.vimeo\\.com)(?:\\/[^\\s]*)?$"
            },
            "caption": {
              "$ref": "#/$defs/__schema12"
            }
          },
          "required": [
            "type",
            "provider",
            "url"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "provider": {
                    "const": "youtube"
                  }
                },
                "required": [
                  "provider"
                ],
                "type": "object"
              },
              "then": {
                "properties": {
                  "url": {
                    "type": "string",
                    "pattern": "^https:\\/\\/(?:youtube\\.com|www\\.youtube\\.com|youtu\\.be|www\\.youtube-nocookie\\.com)(?:\\/[^\\s]*)?$"
                  }
                },
                "type": "object"
              }
            },
            {
              "if": {
                "properties": {
                  "provider": {
                    "const": "vimeo"
                  }
                },
                "required": [
                  "provider"
                ],
                "type": "object"
              },
              "then": {
                "properties": {
                  "url": {
                    "type": "string",
                    "pattern": "^https:\\/\\/(?:vimeo\\.com|player\\.vimeo\\.com)(?:\\/[^\\s]*)?$"
                  }
                },
                "type": "object"
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema3"
            },
            "type": {
              "type": "string",
              "const": "divider"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema3": {
      "$ref": "#/$defs/__schema0"
    },
    "__schema4": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema5"
      }
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "annotations": {
          "type": "object",
          "properties": {
            "bold": {
              "type": "boolean"
            },
            "italic": {
              "type": "boolean"
            },
            "underline": {
              "type": "boolean"
            },
            "strike": {
              "type": "boolean"
            },
            "code": {
              "type": "boolean"
            },
            "sub": {
              "type": "boolean"
            },
            "sup": {
              "type": "boolean"
            },
            "link": {
              "type": "object",
              "properties": {
                "href": {
                  "type": "string",
                  "pattern": "^(https:\\/\\/|mailto:)\\S+$"
                },
                "target": {
                  "type": "string",
                  "const": "_blank"
                }
              },
              "required": [
                "href"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right",
        "justify"
      ]
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/__schema4"
        },
        "items": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema8"
          }
        }
      },
      "required": [
        "content"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/__schema4"
        },
        "items": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema9"
          }
        }
      },
      "required": [
        "content"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": [
        "content"
      ],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/$defs/__schema4"
        },
        "align": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "content"
      ],
      "additionalProperties": false
    },
    "__schema11": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema10"
      }
    },
    "__schema12": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "__schema13": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema14": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https:\\/\\/(?:cdn\\.vfuturelabs\\.org|images\\.unsplash\\.com|upload\\.wikimedia\\.org|commons\\.wikimedia\\.org|[a-z0-9-]+(?:\\.[a-z0-9-]+)*(?:\\.supabase\\.co|\\.supabase\\.in))(?:\\/[^\\s]*)?$"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "__schema15": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "$id": "https://academy.vfuturelabs.org/schemas/v1/authoring/mono/short_answer.json",
  "title": "VFuture MCP short_answer question profile v1",
  "description": "MCP authoring profile v1. Existing profile violations may remain only when their owning construct is unchanged. Server-side semantic and storage checks are also required."
}