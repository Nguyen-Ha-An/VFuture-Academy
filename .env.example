# Supabase (Plan 2). Public keys are safe in the browser; the service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Enable the read-only Studio MCP endpoint and OAuth protected-resource metadata.
STUDIO_MCP_ENABLED=0
# Exact production resource URL that clients enter, e.g. https://academy.example/api/mcp.
MCP_RESOURCE_URL=
# Comma-separated exact browser origins; absent Origin is accepted for server-side clients.
MCP_ALLOWED_ORIGINS=
# Optional temporary restriction. The owner chose to allow all eligible Studio
# accounts during rollout, so leave this variable unset in Production.
# MCP_TESTER_USER_IDS=<comma-separated Supabase Auth user UUIDs>
# Keep live Supabase Auth user checks enabled for every MCP request.
MCP_SESSION_CHECK=1
# Dedicated 32-byte-or-longer random key as 64+ hex chars; required for authoring
# prepare/verify proof. Generate separately from all existing application secrets.
STUDIO_MCP_PREPARATION_PROOF_SECRET=
# Shared secret sent by the Vercel cron scheduler to internal sweep routes.
CRON_SECRET=
# Direct Postgres connection used by scripts/apply-migrations.ts
SUPABASE_DB_URL=
# Independent Academy project identity; required by production scheduler operations.
SUPABASE_PRODUCTION_PROJECT_REF=
SUPABASE_PRODUCTION_DB_URL=
# Public origin used in certificate verification URLs and prompt pack links
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Separate corporate and Competition origins, with no shared runtime code.
NEXT_PUBLIC_CENTRAL_URL=https://vfuturelabs.org
NEXT_PUBLIC_COMPETITION_URL=
# Optional comma-separated HTTPS origins that may retain host-bound auth cookies after callbacks.
AUTH_REDIRECT_ORIGINS=
# Optional public mailbox used by the marketing "For schools" CTA
NEXT_PUBLIC_CONTACT_EMAIL=
# Recovery fixture account provisioned by `npm run setup:staging-auth` and promoted by `npm run seed:dev`.
SEED_ADMIN_EMAIL=
# Read by `setup:staging-auth` for initial creation and by Playwright for sign-in; `seed:dev` never reads passwords.
SEED_ADMIN_PASSWORD=
# Non-production Auth accounts provisioned by `setup:staging-auth`.
# `seed:dev` reads these emails to assign profiles, roles, and fixture content.
SEED_E2E_LEARNER_EMAIL=
SEED_E2E_COMPLETED_LEARNER_EMAIL=
SEED_E2E_PRECOMPLETION_LEARNER_EMAIL=
SEED_E2E_KEYBOARD_LEARNER_EMAIL=
SEED_E2E_A11Y_LEARNER_EMAIL=
SEED_E2E_INSTRUCTOR_EMAIL=
SEED_E2E_BRANCH_LEAD_EMAIL=
SEED_E2E_OTHER_BRANCH_LEARNER_EMAIL=
# Read by `setup:staging-auth` for initial creation and by Playwright where the role is exercised.
SEED_LEARNER_PASSWORD=
SEED_COMPLETED_LEARNER_PASSWORD=
SEED_PRECOMPLETION_LEARNER_PASSWORD=
SEED_KEYBOARD_LEARNER_PASSWORD=
SEED_A11Y_LEARNER_PASSWORD=
SEED_INSTRUCTOR_PASSWORD=
SEED_BRANCH_LEAD_PASSWORD=
SEED_OTHER_BRANCH_LEARNER_PASSWORD=
# Destructively reset only the dedicated mutable learner fixtures before E2E.
# E2E_RESET_SEEDED_LEARNERS=1
# Optional paths to pre-generated Playwright storage states.
PLAYWRIGHT_ADMIN_STORAGE_STATE=
PLAYWRIGHT_LEARNER_STORAGE_STATE=
PLAYWRIGHT_COMPLETED_LEARNER_STORAGE_STATE=
PLAYWRIGHT_PRECOMPLETION_LEARNER_STORAGE_STATE=
PLAYWRIGHT_KEYBOARD_LEARNER_STORAGE_STATE=
PLAYWRIGHT_A11Y_LEARNER_STORAGE_STATE=
PLAYWRIGHT_INSTRUCTOR_STORAGE_STATE=
PLAYWRIGHT_BRANCH_LEAD_STORAGE_STATE=
# Optional local override; the default builds and serves the production app.
# PLAYWRIGHT_WEB_SERVER=dev
# Use remote only with an explicit staging NEXT_PUBLIC_APP_URL; no local server is started.
# PLAYWRIGHT_TARGET=remote
# Hosted staging acceptance must fail rather than skip missing role states.
# E2E_REQUIRE_ROLE_STATES=1
# Production requires this or RATE_LIMIT_COOKIE_SECRET. Trust only a proxy that overwrites forwarding headers.
# Set it alongside the secret in hosted deployments: it is the only per-client signal for a
# visitor's first request, which otherwise shares one capped fallback bucket with all others.
TRUSTED_PROXY=
# Production requires this or TRUSTED_PROXY=1. Use a strong deployment-specific server-only secret.
RATE_LIMIT_COOKIE_SECRET=
# Exact hosted development project ref required to opt `npm run seed:dev` into a non-local project.
SEED_DEV_PROJECT_REF=
# Exceptional override for an explicitly approved non-development seed target.
# SEED_ALLOW_PROD=1
# Guarded answer-save load harness; uncomment only for an approved non-production target.
# LOAD_TEST_ALLOW=1
# BASE_URL=https://approved-staging.example
# LOAD_TEST_SEED_FILE=/secure/path/answer-load-seeds.json
# LOAD_TEST_TIMEOUT_MS=10000
# Optional error-reporting sink placeholders; no SDK is initialized by this repository.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional isolated static JupyterLite deployment. Never use the application origin.
NEXT_PUBLIC_NOTEBOOK_RUNTIME_URL=

# Signed-in learner pages always use the refined UI, and Studio, Grading and Admin
# always use Catmin; rollback for either uses a previous deployment revision.
# Only auth reads this setting: include auth to opt in to its bench.
# UI_V2_SURFACES=auth
# Playwright inherits a local UI_V2_SURFACES value; set E2E_UI_V2_SURFACES
# explicitly when testing a remote server with a different auth setting.
# E2E_UI_V2_SURFACES=auth

# Server-only fixture guard, off by default. With HIDE_INTERNAL_CONTENT=1, rows whose
# id starts with `recovery-`, plus any ids in INTERNAL_CONTENT_IDS (comma list), are
# hidden from learner and public lists, counts, the sitemap and public detail pages.
# Learner detail pages and rows a learner is enrolled in stay reachable. Nothing is deleted.
# HIDE_INTERNAL_CONTENT=1
# INTERNAL_CONTENT_IDS=

# Optional public Google Search Console HTML verification token (not a secret).
# Configure only with the property owner's supplied token; this does not verify ownership by itself.
GOOGLE_SITE_VERIFICATION=
# Server-only publication gate. Leave drafts unapproved until owner/legal review is complete.
# Approval also requires an actual YYYY-MM-DD effective date and final reviewed policy copy.
PUBLIC_POLICIES_APPROVED=false
PUBLIC_POLICIES_EFFECTIVE_DATE=
